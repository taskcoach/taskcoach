<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright 2013-2026 Task Coach developers -->
<component type="desktop-application">
  <id>io.github.taskcoach.TaskCoach</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Task Coach</name>
  <summary>Your friendly task manager</summary>
  <developer id="io.github.taskcoach">
    <name>Task Coach developers</name>
  </developer>

  <description>
    <p>
      Task Coach is a free open source todo manager to manage personal tasks
      and todo lists. It grew out of frustration about other programs not
      handling composite tasks well.
    </p>
    <p>
      In addition to flexible composite tasks, Task Coach has grown to include
      prerequisites, prioritizing, effort tracking against a budget per task,
      category tags, notes, and many other features. Users are not forced to
      use all of them; Task Coach can be as simple or as complex as needed.
    </p>
  </description>

  <launchable type="desktop-id">io.github.taskcoach.TaskCoach.desktop</launchable>

  <!-- Task Coach opens its own .tsk task files; see the bundled MIME
       definition (io.github.taskcoach.TaskCoach.mime.xml). -->
  <provides>
    <mediatype>application/x-taskcoach</mediatype>
  </provides>

  <!-- Committed 2.x screenshots. The raw URLs resolve once this branch is
       merged to master; Flathub mirrors them at submission time. -->
  <screenshots>
    <screenshot type="default">
      <caption>The main window: tasks colour-coded by status, with categories and task editors</caption>
      <image>https://raw.githubusercontent.com/taskcoach/taskcoach/master/website.in/screenshots/taskcoach-main-window.png</image>
    </screenshot>
    <screenshot>
      <caption>Managing task dependencies and prerequisites</caption>
      <image>https://raw.githubusercontent.com/taskcoach/taskcoach/master/website.in/screenshots/taskcoach-dependencies.png</image>
    </screenshot>
  </screenshots>

  <url type="homepage">https://github.com/taskcoach/taskcoach</url>
  <url type="bugtracker">https://github.com/taskcoach/taskcoach/issues</url>
  <url type="faq">https://answers.launchpad.net/taskcoach/+faqs</url>

  <content_rating type="oars-1.1" />

  <releases>
    <release version="2.0.2.18" date="2026-06-09">
      <description>
        <p>Adds a Flatpak package, plus bug fixes and packaging improvements.</p>
      </description>
    </release>
  </releases>
</component>
